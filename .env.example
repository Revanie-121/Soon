# Sonora Music Search & Download Environment Configuration

# Backend Host & Port
APP_HOST="0.0.0.0"
APP_PORT="8000"

# Optional API Bearer Token
API_TOKEN=""

# LucidaDL & Virtual Display
LUCIDADL_EXECUTABLE="lucidadl"
XVFB_RUN_EXECUTABLE="xvfb-run"
LUCIDADL_WORKDIR="/tmp/sonora_downloads"
LUCIDADL_TIMEOUT_SECONDS="300"

# Optional Metadata Endpoint
AMAZON_METADATA_ENDPOINT=""
